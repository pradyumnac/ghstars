# Normalise line endings. Git stores LF; checkouts get LF on every platform.
* text=auto eol=lf

# Binary files must never be normalised.
*.png binary
*.jpg binary
*.gz  binary
*.zip binary

# Generated files: collapse them in diffs and exclude from language stats.
uv.lock    linguist-generated=true -diff
CHANGELOG.md linguist-generated=true
